<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.ucc.reportes.ui.PlantillasController" styleClass="seccion" spacing="12">
    <Label text="%plantillas.titulo" styleClass="titulo"/>
    <HBox spacing="12">
        <Button text="%plantillas.registrar" onAction="#registrar" styleClass="boton-principal"/>
    </HBox>
    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <ListView fx:id="lista" prefWidth="340" minWidth="260"/>
        <StackPane HBox.hgrow="ALWAYS" styleClass="tarjeta">
            <Label fx:id="sinSeleccion" text="%plantillas.seleccione" styleClass="nota"/>
            <VBox fx:id="detalle" spacing="10">
                <Label fx:id="nombre" styleClass="titulo-tarjeta" wrapText="true"/>
                <Label fx:id="tipo" styleClass="nota"/>
                <Label fx:id="descripcion" wrapText="true"/>
                <Label text="%plantillas.marcadoresTitulo" styleClass="subtitulo-tarjeta"/>
                <ListView fx:id="marcadores" VBox.vgrow="ALWAYS" prefHeight="160"/>
                <Label fx:id="infoTabla" wrapText="true" styleClass="nota"/>
                <HBox spacing="8">
                    <Button text="%plantillas.usar" onAction="#usar" styleClass="boton-principal"/>
                    <Button fx:id="abrirWord" text="%plantillas.abrirWord" onAction="#abrirWord"/>
                    <Button fx:id="volverALeer" text="%plantillas.volverALeer" onAction="#volverALeer"/>
                    <Button fx:id="eliminar" text="%comun.eliminar" onAction="#eliminar" styleClass="boton-peligro"/>
                </HBox>
                <TitledPane text="%plantillas.comoEscribir" expanded="false">
                    <Label text="%plantillas.comoEscribir.texto" wrapText="true"/>
                </TitledPane>
            </VBox>
        </StackPane>
    </HBox>
</VBox>
