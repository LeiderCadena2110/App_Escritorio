<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.ucc.reportes.ui.AjustesController" styleClass="seccion" spacing="12">
    <Label text="%ajustes.titulo" styleClass="titulo"/>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="%ajustes.general">
            <VBox spacing="14" styleClass="tarjeta">
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="200"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="%ajustes.carpeta" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="carpeta" editable="false" HBox.hgrow="ALWAYS"/>
                        <Button text="%comun.cambiar" onAction="#elegirCarpeta"/>
                        <Button text="%ajustes.porDefecto" onAction="#carpetaPorDefecto"/>
                    </HBox>
                    <Label text="%ajustes.fecha" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="formatoFecha" prefWidth="360" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="%ajustes.numero" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="formatoNumero" prefWidth="360" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label text="%ajustes.idioma" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <VBox spacing="4" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <ComboBox fx:id="idioma" prefWidth="360"/>
                        <Label fx:id="avisoIdioma" text="%ajustes.idiomaReinicio" styleClass="texto-aviso"/>
                    </VBox>
                </GridPane>
                <Label fx:id="ejemplo" styleClass="resumen"/>
                <Label text="%ajustes.formatosNota" styleClass="nota" wrapText="true"/>
            </VBox>
        </Tab>
        <Tab text="%ajustes.apariencia">
            <VBox spacing="12" styleClass="tarjeta">
                <fx:define>
                    <ToggleGroup fx:id="grupoTema"/>
                </fx:define>
                <Label text="%ajustes.tema" styleClass="subtitulo-tarjeta"/>
                <RadioButton fx:id="temaClaro" text="%ajustes.temaClaro" toggleGroup="$grupoTema"/>
                <RadioButton fx:id="temaOscuro" text="%ajustes.temaOscuro" toggleGroup="$grupoTema"/>
                <Label text="%ajustes.datosLocales" styleClass="nota" wrapText="true"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
