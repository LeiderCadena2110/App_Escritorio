<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Inventory: stock history (kardex) and manual movements -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.ucc.stockflow.ui.controller.InventoryController"
      styleClass="section" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label styleClass="title" text="Inventario"/>
            <Label styleClass="subtitle" text="Entradas, salidas y ajustes de stock"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Exportar CSV" onAction="#exportCsv"/>
        <Button text="Ajuste / salida" onAction="#newAdjustment"/>
        <Button text="Entrada por compra" styleClass="primary-button" onAction="#newPurchase"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <ComboBox fx:id="productBox" prefWidth="300"/>
        <ComboBox fx:id="typeBox" prefWidth="200"/>
        <Label text="Desde" styleClass="form-label"/>
        <DatePicker fx:id="fromDate" prefWidth="140"/>
        <Label text="Hasta" styleClass="form-label"/>
        <DatePicker fx:id="toDate" prefWidth="140"/>
        <Button text="Quitar filtros" styleClass="link-button" onAction="#clearFilters"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="productInfoLabel" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" styleClass="muted"/>
    </HBox>
</VBox>
