<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- AI assistant: read a supplier's invoice into a purchase, and what to buy (restock plan) -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.ucc.stockflow.assistant.ui.AssistantController"
      styleClass="section" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label styleClass="title" text="Asistente IA"/>
            <Label styleClass="subtitle" text="Compras más rápidas con inteligencia artificial (Gemini)"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="aiStatus" styleClass="badge"/>
        <Button fx:id="configureButton" text="Configurar" onAction="#configure"/>
    </HBox>

    <HBox styleClass="card" spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="card-title" text="Leer factura de proveedor"/>
            <Label styleClass="muted" wrapText="true" minHeight="-Infinity"
                   text="Tome una foto o use el PDF de la factura de compra. La IA lee los productos, cantidades y costos, y usted revisa todo antes de sumar el stock."/>
        </VBox>
        <Button fx:id="readInvoiceButton" text="Elegir foto o PDF…" styleClass="primary-button"
                minWidth="-Infinity" onAction="#readInvoice"/>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2">
                <Label styleClass="card-title" text="¿Qué debo comprar?"/>
                <Label fx:id="planSummary" styleClass="muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Ventas de los últimos" styleClass="form-label"/>
            <ComboBox fx:id="periodBox" prefWidth="110"/>
            <Button fx:id="summaryButton" text="Nota de compra con IA" onAction="#summarize"/>
        </HBox>
        <TableView fx:id="planTable" VBox.vgrow="ALWAYS" minHeight="160"/>
        <VBox fx:id="notePane" spacing="6" managed="false" visible="false">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="card-title" text="Nota de compra"/>
                <Label fx:id="noteSource" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Copiar" onAction="#copyNote"/>
            </HBox>
            <TextArea fx:id="noteArea" editable="false" wrapText="true" prefRowCount="7"/>
        </VBox>
    </VBox>
</VBox>
