<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Proveedores: list, search, create, edit and delete -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.ucc.stockflow.ui.controller.SuppliersController"
      styleClass="section" spacing="14">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="2">
            <Label styleClass="title" text="Proveedores"/>
            <Label styleClass="subtitle" text="Empresas a las que les compra mercancía"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo proveedor" styleClass="primary-button" onAction="#create"/>
    </HBox>
    <TextField fx:id="searchField" promptText="Buscar por nombre, NIT o contacto" maxWidth="360"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Button fx:id="editButton" text="Editar" onAction="#editSelected"/>
        <Button fx:id="deleteButton" text="Eliminar" styleClass="danger-button" onAction="#deleteSelected"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" styleClass="muted"/>
    </HBox>
</VBox>
