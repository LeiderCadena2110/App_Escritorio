<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Main window: menu on top, fixed sidebar on the left and the changing center -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.ucc.stockflow.app.MainController"
            styleClass="window" prefWidth="1240" prefHeight="780">
    <top>
        <MenuBar fx:id="menuBar"/>
    </top>
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="3" prefWidth="210"/>
    </left>
    <center>
        <!-- Toasts (Toasts.attach) float on top of this area -->
        <StackPane fx:id="center">
            <StackPane fx:id="content" styleClass="content"/>
            <!-- Shown while data is loading in the background -->
            <HBox fx:id="loadingBadge" styleClass="loading-badge" spacing="8" alignment="CENTER"
                  StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity"
                  mouseTransparent="true" visible="false">
                <ProgressIndicator prefWidth="16" prefHeight="16"/>
                <Label text="Cargando…"/>
                <StackPane.margin>
                    <Insets top="10" right="18"/>
                </StackPane.margin>
            </HBox>
        </StackPane>
    </center>
</BorderPane>
